{
  "name": "@njydsz/ydb-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Ydsz Buddy filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@njydsz/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@njydsz/ydb-attachment": "workspace:^",
    "@njydsz/ydb-fs": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-sandbox": "workspace:^",
    "@njydsz/ydb-sandbox-policy": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-user-approval": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-agent-loop": "workspace:^",
    "@njydsz/ydb-agent-loop-testkit": "workspace:^",
    "@njydsz/ydb-attachment": "workspace:^",
    "@njydsz/ydb-fs": "workspace:^",
    "@njydsz/ydb-fs-local": "workspace:^",
    "@njydsz/ydb-fs-observation-policy": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-llm-deepseek": "workspace:^",
    "@njydsz/ydb-sandbox": "workspace:^",
    "@njydsz/ydb-sandbox-policy": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-user-approval": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
