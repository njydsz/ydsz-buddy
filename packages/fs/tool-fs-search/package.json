{
  "name": "@njydsz/ydb-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@njydsz/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-output-retention": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-spill": "workspace:^",
    "@njydsz/ydb-subprocess": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-timeout": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-subprocess": "workspace:^",
    "@njydsz/ydb-subprocess-local": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-output-retention": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-spill": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-timeout": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
