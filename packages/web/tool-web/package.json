{
  "name": "@njydsz/ydb-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Ydsz Buddy web capability seam (ctx.web)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-web": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@njydsz/schemastery": "workspace:^",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@types/turndown": "^5.0.6",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-spill-local": "workspace:^",
    "@njydsz/ydb-spill-policy": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-tool-call-timeout-policy": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-web": "workspace:^",
    "@njydsz/ydb-web-fetch-http": "workspace:^",
    "@njydsz/ydb-web-search-exa": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
