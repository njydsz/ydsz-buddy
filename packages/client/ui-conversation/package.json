{
  "name": "@njydsz/ydb-client-ui-conversation",
  "description": "Conversation domain: skeleton, ordered chat flow, composer with the Host-backed busy-Enter preference, and details host",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ydb": {
    "client": {
      "inject": [
        "@njydsz/ydb-client-connection",
        "@njydsz/ydb-client-locale",
        "@njydsz/ydb-client-runtime",
        "@njydsz/ydb-client-ui-settings",
        "@njydsz/ydb-api-remotes",
        "@njydsz/ydb-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@njydsz/ydb-settings": "workspace:^",
    "clsx": "^2.0.0",
    "@njydsz/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@njydsz/cordis": "workspace:^",
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-api-remotes": "workspace:^",
    "@njydsz/ydb-attachment": "workspace:^",
    "@njydsz/ydb-brand": "workspace:^",
    "@njydsz/ydb-client-connection": "workspace:^",
    "@njydsz/ydb-client-locale": "workspace:^",
    "@njydsz/ydb-client-runtime": "workspace:^",
    "@njydsz/ydb-client-ui-attachment": "workspace:^",
    "@njydsz/ydb-client-ui-primitives": "workspace:^",
    "@njydsz/ydb-client-ui-settings": "workspace:^",
    "@njydsz/ydb-client-ui-input-trigger": "workspace:^",
    "@njydsz/ydb-client-ui-slots": "workspace:^",
    "@njydsz/ydb-commands": "workspace:^",
    "@njydsz/ydb-compaction": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm-retry": "workspace:^",
    "@njydsz/ydb-session-stats": "workspace:^",
    "@njydsz/ydb-token-meter": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@njydsz/cordis": "workspace:^",
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-api-remotes": "workspace:^",
    "@njydsz/ydb-attachment": "workspace:^",
    "@njydsz/ydb-brand": "workspace:^",
    "@njydsz/ydb-client-connection": "workspace:^",
    "@njydsz/ydb-client-locale": "workspace:^",
    "@njydsz/ydb-client-runtime": "workspace:^",
