{
  "name": "@njydsz/ydb-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ydb": {
    "client": {
      "inject": [
        "@njydsz/ydb-client-connection",
        "@njydsz/ydb-typert-registry",
        "@njydsz/ydb-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-attachment": "workspace:^",
    "@njydsz/ydb-client-connection": "workspace:^",
    "@njydsz/ydb-commands": "workspace:^",
    "@njydsz/ydb-client-ui-slots": "workspace:^",
    "@njydsz/ydb-host-apiproxy": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-llm-retry": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-session-projection": "workspace:^",
    "@njydsz/ydb-session-title": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "immer": "^10.1.1",
    "react": "^18.2.0",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@njydsz/cordis": "workspace:^",
    "@njydsz/ydb-api-remotes": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-typert-protocol": "workspace:^",
    "@njydsz/ydb-typert-registry": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/cordis": "workspace:^",
    "@njydsz/ydb-api-remotes": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-timeout": "workspace:^",
    "@njydsz/ydb-typert-protocol": "workspace:^",
    "@njydsz/ydb-typert-registry": "workspace:^",
    "@types/react": "~18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
