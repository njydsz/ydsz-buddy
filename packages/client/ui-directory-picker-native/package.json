{
  "name": "@njydsz/ydb-client-ui-directory-picker-native",
  "description": "Native directory-picker surface: the renderless workspace directory-flow occupant driving the host's OS chooser",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/client/ui-directory-picker-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ydb": {
    "client": {
      "inject": [
        "@njydsz/ydb-client-runtime",
        "@njydsz/ydb-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@njydsz/ydb-client-runtime": "workspace:^",
    "@njydsz/ydb-client-ui-slots": "workspace:^",
    "@njydsz/ydb-client-ui-workspace": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@njydsz/ydb-client-runtime": "workspace:^",
    "@njydsz/ydb-client-ui-slots": "workspace:^",
    "@njydsz/ydb-client-ui-workspace": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@njydsz/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
