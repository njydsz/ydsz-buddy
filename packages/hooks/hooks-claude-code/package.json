{
  "name": "@njydsz/ydb-hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the Ydsz Buddy interception seams",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/hooks/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@njydsz/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-hook-protocol": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-session-persistence": "workspace:^",
    "@njydsz/ydb-subagent": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-agent-loop": "workspace:^",
    "@njydsz/ydb-agent-loop-testkit": "workspace:^",
    "@njydsz/ydb-shell": "workspace:^",
    "@njydsz/ydb-bash-local": "workspace:^",
    "@njydsz/ydb-subprocess-local": "workspace:^",
    "@njydsz/ydb-hook-protocol": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-session-persistence": "workspace:^",
    "@njydsz/ydb-session-persistence-jsonl": "workspace:^",
    "@njydsz/ydb-subagent": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
