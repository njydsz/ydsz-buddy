{
  "name": "@njydsz/ydb-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@njydsz/ydb-attachment": "workspace:^",
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-agent-default-model": "workspace:^",
    "@njydsz/ydb-api-remotes": "workspace:^",
    "@njydsz/ydb-brand": "workspace:^",
    "@njydsz/ydb-commands": "workspace:^",
    "@njydsz/ydb-credentials": "workspace:^",
    "@njydsz/ydb-goal": "workspace:^",
    "@njydsz/ydb-host-directory-picker": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-native-command": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-session-persistence": "workspace:^",
    "@njydsz/ydb-session-projection": "workspace:^",
    "@njydsz/ydb-session-projection-cache": "workspace:^",
    "@njydsz/ydb-session-query": "workspace:^",
    "@njydsz/ydb-session-title": "workspace:^",
    "@njydsz/ydb-settings": "workspace:^",
    "@njydsz/ydb-skill": "workspace:^",
    "@njydsz/ydb-subagent": "workspace:^",
    "@njydsz/ydb-jobs": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-user-approval": "workspace:^",
    "@njydsz/ydb-user-questions": "workspace:^",
    "@njydsz/ydb-workspace": "workspace:^",
    "@njydsz/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@njydsz/cordis": "workspace:^",
    "@njydsz/ydb-agent-presets": "workspace:^",
    "@njydsz/ydb-cordis-host-runner": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/cordis": "workspace:^",
    "@njydsz/ydb-agent-presets": "workspace:^",
    "@njydsz/ydb-cordis-host-runner": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-storage": "workspace:^",
    "@njydsz/ydb-storage-domain": "workspace:^",
    "@njydsz/ydb-typert-protocol": "workspace:^",
    "@njydsz/ydb-typert-registry": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
