{
  "name": "@njydsz/dsh-tool-pwsh",
  "description": "Model-facing pwsh tool over the bash executor seam",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/ydsz-buddy.git",
    "directory": "packages/shell/tool-pwsh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@njydsz/dsh-agent": "workspace:^",
    "@njydsz/dsh-shell": "workspace:^",
    "@njydsz/dsh-shell-env": "workspace:^",
    "@njydsz/dsh-invariants": "workspace:^",
    "@njydsz/dsh-llm": "workspace:^",
    "@njydsz/dsh-sandbox": "workspace:^",
    "@njydsz/dsh-sandbox-policy": "workspace:^",
    "@njydsz/dsh-system-prompt": "workspace:^",
    "@njydsz/dsh-jobs": "workspace:^",
    "@njydsz/dsh-tools": "workspace:^",
    "@njydsz/dsh-user-approval": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  },
  "dependencies": {
    "@njydsz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/dsh-agent": "workspace:^",
    "@njydsz/dsh-shell": "workspace:^",
    "@njydsz/dsh-shell-env": "workspace:^",
    "@njydsz/dsh-invariants": "workspace:^",
    "@njydsz/dsh-llm": "workspace:^",
    "@njydsz/dsh-loader-smoke": "workspace:^",
    "@njydsz/dsh-pwsh-local": "workspace:^",
    "@njydsz/dsh-sandbox": "workspace:^",
    "@njydsz/dsh-sandbox-policy": "workspace:^",
    "@njydsz/dsh-subprocess-local": "workspace:^",
    "@njydsz/dsh-system-prompt": "workspace:^",
    "@njydsz/dsh-jobs": "workspace:^",
    "@njydsz/dsh-jobs-local": "workspace:^",
    "@njydsz/dsh-tool-jobs": "workspace:^",
    "@njydsz/dsh-tools": "workspace:^",
    "@njydsz/dsh-user-approval": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
