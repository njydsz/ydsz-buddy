{
  "name": "@njydsz/dsh-bash-local",
  "description": "Local-subprocess implementation of the Ydsz Buddy bash executor seam",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/ydsz-buddy.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@njydsz/dsh-shell": "workspace:^",
    "@njydsz/dsh-invariants": "workspace:^",
    "@njydsz/dsh-subprocess": "workspace:^",
    "@njydsz/dsh-timeout": "workspace:^",
    "@njydsz/cordis": "workspace:^",
    "@njydsz/dsh-settings": "workspace:^"
  },
  "dependencies": {
    "@njydsz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/dsh-shell": "workspace:^",
    "@njydsz/dsh-invariants": "workspace:^",
    "@njydsz/dsh-subprocess": "workspace:^",
    "@njydsz/dsh-subprocess-local": "workspace:^",
    "@njydsz/dsh-timeout": "workspace:^",
    "@njydsz/cordis": "workspace:^",
    "@njydsz/dsh-settings": "workspace:^"
  }
}
