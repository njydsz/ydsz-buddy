{
  "name": "@njydsz/ydb-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njydsz/ydsz-buddy.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-shell": "workspace:^",
    "@njydsz/ydb-shell-env": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-sandbox": "workspace:^",
    "@njydsz/ydb-sandbox-policy": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-jobs": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-user-approval": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  },
  "dependencies": {
    "@njydsz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@njydsz/ydb-agent": "workspace:^",
    "@njydsz/ydb-agent-loop": "workspace:^",
    "@njydsz/ydb-agent-loop-testkit": "workspace:^",
    "@njydsz/ydb-shell": "workspace:^",
    "@njydsz/ydb-shell-env": "workspace:^",
    "@njydsz/ydb-bash-local": "workspace:^",
    "@njydsz/ydb-invariants": "workspace:^",
    "@njydsz/ydb-llm": "workspace:^",
    "@njydsz/ydb-subprocess-local": "workspace:^",
    "@njydsz/ydb-sandbox": "workspace:^",
    "@njydsz/ydb-sandbox-policy": "workspace:^",
    "@njydsz/ydb-session": "workspace:^",
    "@njydsz/ydb-session-persistence-jsonl": "workspace:^",
    "@njydsz/ydb-system-prompt": "workspace:^",
    "@njydsz/ydb-jobs": "workspace:^",
    "@njydsz/ydb-jobs-local": "workspace:^",
    "@njydsz/ydb-tool-jobs": "workspace:^",
    "@njydsz/ydb-tools": "workspace:^",
    "@njydsz/ydb-user-approval": "workspace:^",
    "@njydsz/cordis": "workspace:^"
  }
}
