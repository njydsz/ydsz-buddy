{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for Remi Code's main window. Grants the React UI access to the native bridge, file system (scoped to user data and downloads), shell, dialogs, process, OS info, window state, updater, and notifications.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default",
    "core:menu:default",
    "core:tray:default",
    "core:path:default",

    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "shell:default",
    "shell:allow-open",
    "os:default",
    "process:default",
    "window-state:default",
    "updater:default",
    "notification:default",
    "log:default"
  ]
}
