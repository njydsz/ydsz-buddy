{
  "name": "@ydsz-buddy/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project default",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project default --coverage",
    "coverage:check-modules": "node scripts/check-coverage-by-module.mjs",
    "coverage:check-modules:strict": "node scripts/check-coverage-by-module.mjs --strict",
    "coverage:ci": "pnpm test:coverage && pnpm coverage:check-modules",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install chromium --with-deps",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:stable": "playwright test --config e2e/playwright.config.ts --project=stable",
    "test:e2e:flaky": "playwright test --config e2e/playwright.config.ts --project=flaky-quarantine",
    "test:e2e:smoke": "playwright test --config e2e/playwright.config.ts --project=stable --grep=@smoke",
    "test:e2e:p0": "playwright test --config e2e/playwright.config.ts --project=stable --grep=@p0",
    "test:e2e:p1": "playwright test --config e2e/playwright.config.ts --project=stable --grep=@p1",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install --config e2e/playwright.config.ts",
    "test:e2e:install-deps": "playwright install-deps --config e2e/playwright.config.ts",
    "test:e2e:driver": "node e2e/scripts/start-tauri-driver.mjs",
    "flakiness:dashboard": "node ../.github/scripts/flakiness-dashboard.mjs --junit e2e/test-results/junit.xml --history ../.github/test-flakiness/history.json --output ../.github/test-flakiness/dashboard.json --markdown ../.github/test-flakiness/dashboard.md --source playwright",
    "flakiness:dashboard:vitest": "node ../.github/scripts/flakiness-dashboard.mjs --junit coverage/junit.xml --history ../.github/test-flakiness/history.json --output ../.github/test-flakiness/dashboard.json --markdown ../.github/test-flakiness/dashboard.md --source vitest",
    "flakiness:reset": "node -e \"require('node:fs').writeFileSync('../.github/test-flakiness/history.json', JSON.stringify({_comment:'',windowSize:30,updatedAt:new Date().toISOString(),runs:[]}, null, 2))\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test-storybook": "vitest run --project storybook",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes",
    "bench": "vitest bench",
    "bench:ci": "vitest bench --run --reporter=default",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/platform": "^0.96.2",
    "@effect/rpc": "^0.75.1",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@formkit/auto-animate": "^0.9.0",
    "@legendapp/list": "^3.0.6",
    "@lexical/react": "^0.45.0",
    "@monaco-editor/react": "^4.6.0",
    "@pierre/diffs": "^1.2.11",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.50.0",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.7.0",
    "@xterm/addon-ligatures": "^0.9.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "effect": "^3.21.3",
    "katex": "^0.16.0",
    "lexical": "^0.45.0",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.52.0",
    "msw": "^2.14.6",
    "react": "^18.2.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@eslint/js": "^9.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fast-check": "^3.23.2",
    "globals": "^15.10.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.48.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "vitest-browser-react": "^2.2.0"
  }
}
