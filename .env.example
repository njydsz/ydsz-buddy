# ============================================================
# ydsz-buddy 环境变量配置
# ============================================================
# 复制为 .env 或 .env.local 使用，按需取消注释覆盖默认值。
# ============================================================

# ---------- 日志 ----------
# tracing 日志级别过滤（参考 env-filter 语法）
# 可选：trace, debug, info, warn, error
# 示例：RUST_LOG=ydsz_buddy=debug,ydsz_provider=trace
RUST_LOG=info

# ---------- OpenTelemetry 分布式追踪 ----------
# OTLP gRPC 端点（留空则仅输出 span 到 stdout 不上报 Collector）
# 典型值：http://localhost:4317（本地 Collector）
# OTEL_EXPORTER_OTLP_ENDPOINT=

# 服务名称（在 Jaeger/Tempo/Phoenix 等后端标识为独立服务）
# OTEL_SERVICE_NAME=ydsz-buddy

# 采样策略：always_on / always_off / traceidratio
# OTEL_TRACES_SAMPLER=always_on

# 采样比率（配合 traceidratio 使用，0.0~1.0）
# OTEL_TRACES_SAMPLER_ARG=1.0

# ---------- 桌面端开发调试 ----------
# 启用 WebView2 远程调试端口 9222（仅 debug 构建生效）
# YDSZ_BUDDY_DEVTOOLS=1

# 跳过条款接受状态注入（开发/沙箱场景）
# YDSZ_BUDDY_SKIP_TERMS=1

# webview 性能降级模式（开发模式卡顿排查）
# YDSZ_BUDDY_MIN_HOOKS=1
