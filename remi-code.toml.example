# Remi Code Server Configuration
# This file is optional; environment variables take precedence.

# Server settings
host = "127.0.0.1"
port = 3845
log_level = "info"

# Runtime mode: "server", "desktop", or "dev"
runtime_mode = "server"

# Database path (relative to data_dir or absolute)
db_path = "remi-code.db"

# Data directory for workspace, logs, etc.
data_dir = ".remi-code"

# Authentication token (optional, for development)
# auth_token = "your-secret-token"

# Enable development mode
dev_mode = false
