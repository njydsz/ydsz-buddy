---
const year = new Date().getFullYear();
const groups = [
  {
    title: "Product",
    links: [
      { href: "/features", label: "Features" },
      { href: "/download", label: "Download" },
      { href: "/changelog", label: "Changelog" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "/docs", label: "Documentation" },
      { href: "/blog", label: "Blog" },
      { href: "https://github.com/remi-code/remi-code", label: "GitHub" },
    ],
  },
  {
    title: "Community",
    links: [
      { href: "https://github.com/remi-code/remi-code/discussions", label: "Discussions" },
      { href: "https://github.com/remi-code/remi-code/issues", label: "Issue tracker" },
      { href: "/security", label: "Security" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">R</span>
        <span class="brand-name">Remi Code</span>
      </a>
      <p class="muted">
        AI-native desktop IDE with multi-provider orchestration, worktree-native workflow
        and full code provenance.
      </p>
    </div>
    {
      groups.map((group) => (
        <div class="footer-col">
          <h4>{group.title}</h4>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container footer-bottom">
    <p class="muted">© {year} Remi Code contributors. Released under the MIT License.</p>
    <p class="muted">
      Built with <a href="https://astro.build">Astro</a> · Powered by
      <a href="https://tauri.app">Tauri</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding: 56px 0 24px;
    margin-top: 80px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .footer-brand .brand {
    color: var(--color-text-primary);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .footer-brand .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1 0%, #10b981 100%);
    color: white;
    font-weight: 800;
  }
  .footer-brand p {
    max-width: 360px;
    margin-top: 12px;
  }
  .footer-col h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-col a {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
  .footer-col a:hover {
    color: var(--color-text-primary);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
  }
  .footer-bottom p {
    margin: 0;
  }
  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 500px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
