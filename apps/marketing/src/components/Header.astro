---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/features", label: "Features" },
  { href: "/download", label: "Download" },
  { href: "/changelog", label: "Changelog" },
  { href: "/docs", label: "Docs" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Remi Code home">
      <span class="brand-mark" aria-hidden="true">R</span>
      <span class="brand-name">Remi Code</span>
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { active: currentPath === link.href }]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/download" class="btn btn-primary header-cta">Get Remi</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: rgba(10, 14, 26, 0.75);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-primary);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .brand:hover {
    color: var(--color-text-primary);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1 0%, #10b981 100%);
    color: white;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .primary-nav {
    flex: 1;
  }

  .primary-nav ul {
    list-style: none;
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
    transition: all 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
  }
  .nav-link.active {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-accent);
  }

  .header-cta {
    padding: 0.5em 1.1em;
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .primary-nav {
      display: none;
    }
  }
</style>
