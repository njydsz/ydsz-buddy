---
import BaseLayout from "~/layouts/BaseLayout.astro";

const sections = [
  {
    title: "Getting started",
    items: [
      { label: "Install Remi Code", href: "#install" },
      { label: "Open your first repo", href: "#first-repo" },
      { label: "Start a thread", href: "#first-thread" },
    ],
  },
  {
    title: "Core concepts",
    items: [
      { label: "Threads & turns", href: "#threads" },
      { label: "Worktrees", href: "#worktrees" },
      { label: "Projections & checkpoints", href: "#projections" },
    ],
  },
  {
    title: "Operations",
    items: [
      { label: "Provider adapters", href: "#providers" },
      { label: "JSON-RPC control plane", href: "#rpc" },
      { label: "CLI reference", href: "#cli" },
    ],
  },
];
---

<BaseLayout
  title="Documentation"
  description="The official Remi Code documentation: install, core concepts, provider adapters, and the JSON-RPC control plane."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow">Documentation</span>
        <h1>Everything you need to ship with Remi Code.</h1>
        <p>
          The documentation is open source and lives alongside the code in the
          <a
            href="https://github.com/remi-code/remi-code/tree/main/.docs"
            rel="noopener">.docs</a
          > directory. This page is a high-level index of the most useful entry
          points.
        </p>
      </div>
    </div>
  </section>

  <section class="section docs-section">
    <div class="container">
      <div class="docs-grid">
        {
          sections.map((section) => (
            <article class="docs-card">
              <h2>{section.title}</h2>
              <ul>
                {section.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="muted docs-note">
        Looking for the API reference? Head to
        <a
          href="https://github.com/remi-code/remi-code/tree/main/.docs/api"
          rel="noopener">.docs/api</a
        > — every public Rust type, JSON-RPC method, and Tauri command is
        documented there.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head {
    max-width: 720px;
  }
  .docs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 800px) {
    .docs-grid {
      grid-template-columns: 1fr;
    }
  }
  .docs-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .docs-card h2 {
    font-size: 1.05rem;
    margin: 0 0 12px;
  }
  .docs-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .docs-card a {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }
  .docs-card a:hover {
    color: var(--color-accent);
  }
  .docs-note {
    margin-top: 24px;
    font-size: 0.9rem;
  }
</style>
