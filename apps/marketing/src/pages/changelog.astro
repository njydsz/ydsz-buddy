---
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Release {
  version: string;
  date: string;
  highlight: string;
  type: "major" | "minor" | "patch";
  changes: { type: "added" | "changed" | "fixed" | "removed"; text: string }[];
}

const releases: Release[] = [
  {
    version: "0.1.0",
    date: "2026-06-20",
    highlight: "Public preview of the multi-provider orchestration engine.",
    type: "major",
    changes: [
      {
        type: "added",
        text: "Initial release of Remi Code desktop app (Tauri 2.x).",
      },
      {
        type: "added",
        text: "Orchestration engine with CQRS + event sourcing over SQLite.",
      },
      {
        type: "added",
        text: "Provider adapters for OpenAI, Anthropic, Google Gemini and Ollama.",
      },
      {
        type: "added",
        text: "Worktree-native development workflow with checkpoint/replay.",
      },
      {
        type: "added",
        text: "JSON-RPC 2.0 control plane over WebSocket and Tauri IPC.",
      },
    ],
  },
];
---

<BaseLayout
  title="Changelog"
  description="Release notes and changelog for Remi Code — every version, every fix, every migration note."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow">Changelog</span>
        <h1>Every release, every fix.</h1>
        <p>
          Remi Code follows <a href="https://semver.org">Semantic Versioning</a>.
          The full release notes live on
          <a
            href="https://github.com/remi-code/remi-code/releases"
            rel="noopener">GitHub</a
          > — the page below mirrors the most important highlights.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="release-list">
        {
          releases.map((release) => (
            <li class="release-card" id={`v${release.version}`}>
              <header>
                <div>
                  <h2>
                    v{release.version}
                    <span class={`type-tag type-${release.type}`}>
                      {release.type}
                    </span>
                  </h2>
                  <time datetime={release.date} class="muted small">
                    Released {release.date}
                  </time>
                </div>
                <a
                  class="btn btn-ghost"
                  href={`https://github.com/remi-code/remi-code/releases/tag/v${release.version}`}
                  rel="noopener"
                >
                  View on GitHub →
                </a>
              </header>
              <p class="highlight">{release.highlight}</p>
              <ul class="change-list">
                {release.changes.map((change) => (
                  <li class={`change change-${change.type}`}>
                    <span class="change-tag">{change.type}</span>
                    <span>{change.text}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head {
    max-width: 720px;
  }
  .release-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .release-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px;
  }
  .release-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .release-card h2 {
    margin: 0 0 4px;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .type-tag {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 700;
  }
  .type-major {
    background: rgba(99, 102, 241, 0.18);
    color: #818cf8;
  }
  .type-minor {
    background: rgba(16, 185, 129, 0.18);
    color: #34d399;
  }
  .type-patch {
    background: rgba(245, 158, 11, 0.18);
    color: #fbbf24;
  }
  .highlight {
    color: var(--color-text-primary);
    font-size: 1.05rem;
    margin: 0 0 16px;
  }
  .change-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .change {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 10px;
    font-size: 0.92rem;
  }
  .change-tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
    padding-top: 3px;
  }
  .change-added .change-tag {
    color: #34d399;
  }
  .change-fixed .change-tag {
    color: #818cf8;
  }
  .change-changed .change-tag {
    color: #fbbf24;
  }
  .change-removed .change-tag {
    color: #f87171;
  }
  .small {
    font-size: 0.8rem;
  }
</style>
