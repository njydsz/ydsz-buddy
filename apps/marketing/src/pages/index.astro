---
import BaseLayout from "~/layouts/BaseLayout.astro";
import FeatureCard from "~/components/FeatureCard.astro";

const features = [
  {
    icon: "✦",
    title: "Multi-provider orchestration",
    description:
      "Route threads across OpenAI, Anthropic, Google, local models, or your own provider adapters without rewriting your workflow.",
  },
  {
    icon: "⎇",
    title: "Worktree-native development",
    description:
      "Every thread runs in its own git worktree. Branch, stage, and merge without ever leaving the conversation.",
  },
  {
    icon: "◉",
    title: "Full code provenance",
    description:
      "Every diff, plan and approval is captured as a checkpoint. Roll back, replay, or hand off a thread to a teammate in seconds.",
  },
  {
    icon: "▣",
    title: "CQRS event log",
    description:
      "An append-only event store powers projections, audit trails, and reproducible replays of any orchestration session.",
  },
  {
    icon: "▶",
    title: "JSON-RPC control plane",
    description:
      "Every command, stream and notification flows through a single, versioned protocol that mirrors the desktop app's IPC surface.",
  },
  {
    icon: "✺",
    title: "Native desktop UX",
    description:
      "Tauri shell, system file dialogs, multi-tab workspaces, voice input, and a context menu that always knows what you can do.",
  },
];
---

<BaseLayout
  title="Remi Code — AI-native desktop IDE"
  description="Remi Code is an AI-native desktop IDE with multi-provider orchestration, worktree-native workflow, and full code provenance."
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="section-eyebrow">v0.1 · Public Preview</span>
      <h1>
        The desktop IDE that treats
        <span class="text-gradient">AI threads</span> as first-class
        development artifacts.
      </h1>
      <p class="hero-sub">
        Remi Code brings a multi-provider AI control plane, a worktree-native
        developer experience and a fully auditable event log into a single
        Tauri-powered desktop app. Migrate from Cursor, VS Code, or hand-rolled
        Claude workflows without losing the context of what your agents did.
      </p>
      <div class="hero-actions">
        <a href="/download" class="btn btn-primary">Download Remi Code</a>
        <a href="/features" class="btn btn-secondary">Explore features</a>
        <a
          href="https://github.com/remi-code/remi-code"
          class="btn btn-ghost"
          rel="noopener"
        >
          View on GitHub →
        </a>
      </div>
      <div class="hero-meta muted">
        Free · MIT-licensed · macOS · Windows · Linux
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="section-eyebrow">Why Remi Code</span>
        <h2>Built for engineers shipping AI-assisted code, not demos.</h2>
        <p>
          A complete stack — Rust orchestration, SQLite projection store,
          provider adapters, and a TypeScript renderer — designed to be
          inspected, replayed, and audited.
        </p>
      </div>
      <div class="grid grid-3">
        {
          features.map((feature) => (
            <FeatureCard
              icon={feature.icon}
              title={feature.title}
              description={feature.description}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-cta">
    <div class="container cta-card">
      <div>
        <h2>Spin up your first thread in under a minute.</h2>
        <p>
          Install Remi Code, point it at a repo, and start a thread with the
          provider of your choice. We take care of the worktree, the
          checkpoints, and the projection store.
        </p>
      </div>
      <div class="cta-actions">
        <a href="/download" class="btn btn-primary">Download</a>
        <a href="/docs" class="btn btn-secondary">Read the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 96px 0 64px;
  }
  .hero-inner {
    max-width: 820px;
    text-align: left;
  }
  .hero h1 {
    margin: 0 0 20px;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 720px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .hero-meta {
    margin-top: 18px;
    font-size: 0.85rem;
  }
  .section-head {
    max-width: 720px;
    margin-bottom: 40px;
  }
  .section-head p {
    font-size: 1.05rem;
  }
  .section-cta {
    padding-top: 40px;
  }
  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 36px;
    flex-wrap: wrap;
  }
  .cta-card h2 {
    margin: 0 0 6px;
  }
  .cta-card p {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
