{
  "name": "@njydsz/ydb-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Electron desktop shell — Stage 1 HTTP-carriage host runtime reusing the web composition verbatim; Stage 2 IPC carrier planned.",
  "main": "lib/main.js",
  "exports": {
    ".": {
      "types": "./lib/types/main.d.ts",
      "default": "./lib/main.js"
    },
    "./runtime": {
      "types": "./lib/types/electron-runtime.d.ts",
      "default": "./lib/electron-runtime.js"
    }
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@njydsz/cordis": "workspace:*",
    "@njydsz/cordis-plugin-include": "workspace:*",
    "@njydsz/ydb-app-boot": "workspace:*",
    "electron": "^33.0.0"
  },
  "devDependencies": {
    "@njydsz/schemastery": "workspace:*",
    "@types/node": "^22.10.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "ai.deepseek.harness-electron",
    "productName": "DeepSeek Harness",
    "files": [
      "lib/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
