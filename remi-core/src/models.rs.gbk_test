    }
}

impl InteractionMode {
    /// 浠庢棫锟?`chat/review` 瀛楃涓叉槧灏勫埌鏂扮増 5 鎬侊拷?    /// 鏈煡鍊奸粯璁ゆ槧灏勪负 `Agent`锟?    pub fn from_legacy(value: &str) -> Self {
        match value.to_ascii_lowercase().as_str() {
            "chat" => Self::Chat,
            "plan" => Self::Plan,
            "agent" => Self::Agent,
            "review" => Self::Review,
            "task" => Self::Task,
