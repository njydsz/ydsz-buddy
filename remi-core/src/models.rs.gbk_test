/// # 杩愯鏃舵ā寮忔灇涓撅紙Remi Claw 0.2.0锟?///
/// 鎺у埗绾跨▼鎵€灞炵殑浜у搧涓绘ā寮忥紝璋冨害涓嶅悓鐨勫伐鍏烽泦锟?Provider 閾撅細
///
/// - [`Work`](RuntimeMode::Work) - 宸ヤ綔妯″紡锛岃皟锟?Office / 鎵归噺 / 璋冨害 / 娴忚鍣ㄨ嚜鍔ㄥ寲
/// - [`Code`](RuntimeMode::Code) - 浠ｇ爜妯″紡锛岃皟锟?Provider Adapter / 缁堢 / Git锛堥粯璁わ級
///
/// ## 杩佺Щ璇存槑
///
/// 0.1.x 锟?`Agent/Ask/Plan` 涓夋€佸湪 0.2.0 閲嶆瀯锟?Work/Code 鍙岀淮搴︼紱鏃х殑 `Agent/Ask/Plan`
/// 鍦ㄤ簨浠舵祦涓互灏忓啓瀛楃锟?`agent/ask/plan` 褰㈠紡瀛樺湪锛屽弽搴忓垪鍖栨椂閫氳繃
/// [`RuntimeMode::from_legacy`] 鏄犲皠鍒版柊锟?Work/Code 缁村害锟?#[derive(Debug, Clone, Serialize, PartialEq, Eq, Hash)]
#[serde(rename_all = "lowercase")]
pub enum RuntimeMode {
    /// 宸ヤ綔妯″紡锛歄ffice / 鎵归噺 / 璋冨害 / 娴忚鍣ㄨ嚜鍔ㄥ寲
    Work,
    /// 浠ｇ爜妯″紡锛歅rovider / 缁堢 / Git锛堥粯璁わ級
    Code,
}

/// 鑷畾涔夊弽搴忓垪鍖栵細鍏煎鏃х増 `agent/ask/plan` 瀛楃锟?impl<'de> Deserialize<'de> for RuntimeMode {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let raw = String::deserialize(deserializer)?;
        Ok(Self::from_legacy(&raw))
    }
}

impl Default for RuntimeMode {
    fn default() -> Self {
        Self::Code
    }
}

impl RuntimeMode {
    /// 浠庢棫锟?`agent/ask/plan` 瀛楃涓叉槧灏勫埌鏂扮増 `work/code` 缁村害锟?    /// 鏈煡鍊奸粯璁ゆ槧灏勪负 `Code`锟?    pub fn from_legacy(value: &str) -> Self {
        match value.to_ascii_lowercase().as_str() {
            "work" => Self::Work,
            "code" => Self::Code,
            "agent" | "ask" | "plan" => Self::Code,
            _ => Self::Code,
        }
    }

    pub fn is_work(&self) -> bool {
        matches!(self, Self::Work)
    }

    pub fn is_code(&self) -> bool {
        matches!(self, Self::Code)
    }
}

/// # 浜や簰妯″紡鏋氫妇锛圧emi Claw 0.2.0锟?///
